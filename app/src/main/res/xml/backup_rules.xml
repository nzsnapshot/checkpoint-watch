<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older (minSdk is 29), where cloud backup and device transfer are one channel.
  Same answer as data_extraction_rules.xml: nothing is copied off the phone.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
