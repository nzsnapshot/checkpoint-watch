<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer. Nothing this app holds leaves the phone: not to a cloud backup, and not
  to a new phone over device transfer. The database is a log of one person's movements around
  Auckland, and there is no key, no account and no way to encrypt it on the way out, so the answer
  to "may this be copied off the device" is no in both directions.

  android:allowBackup is already false, which is the older and blunter form of the same answer;
  this file is what says it on Android 12+, where the two channels are separate.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
