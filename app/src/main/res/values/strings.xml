    <!-- Settings: scan history -->
    <string name="settings_history_header">Scan history</string>
    <string name="settings_history_body">The last ten checks, so you can see what the app has actually been able to collect.</string>
    <string name="settings_history_empty">No checks have run yet.</string>
    <!-- Two independent counts, not one quantity: "3 new · 10 seen". -->
    <string name="settings_history_counts" tools:ignore="PluralsCandidate">%1$d new · %2$d seen</string>
    <string name="trigger_foreground">Foreground</string>
    <string name="trigger_background">Background</string>
    <string name="status_ok">Finished</string>
    <string name="status_ok_with_gap">Finished, with a gap</string>
    <string name="status_failed_network">Couldn\'t connect</string>
    <string name="status_failed_no_data">No posts returned</string>
    <string name="status_cancelled">Stopped early</string>
    <!-- Why the collector stopped. The sign-in wall is the normal, healthy end of a full scan:
         Facebook stops serving posts to a logged-out visitor after about ten, so the row says so
         rather than reading as a failure. -->
    <string name="end_login_wall">Reached Facebook\'s sign-in wall (normal)</string>
    <string name="end_no_more_posts">Reached the end of the posts</string>
    <!-- The VPN case: the login dialog was closed and nothing followed it. Named plainly, because
         it is not a fault the owner can fix and the app has already worked around it. -->
    <string name="end_no_feed">Facebook withheld the feed (common on a VPN)</string>
    <string name="end_timeout">Ran out of time</string>
    <string name="end_network_error">Network problem</string>
    <string name="end_blocked">Facebook redirected to sign-in</string>
    <string name="end_cancelled">Stopped when the app closed</string>
    <string name="collector_webview">Full page</string>
    <string name="collector_webview_dom">Page text</string>
    <!-- Facebook's own embed, which is capped at five posts. The number is in the label because
         "how many could it possibly have seen?" is the question this row exists to answer. -->
    <string name="collector_plugin">Page widget (5 newest)</string>
    <string name="collector_http">Newest post only</string>
    <string name="collector_relay">Home collector</string>
    <string name="collector_none">Nothing collected</string>

    <!-- Settings: scan details. The hidden WebView cannot be inspected from outside the app, so
