<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      WorkManager merges this in anyway, to wait for a connection before a background check. It is
      declared here as well because the app now reads it directly, for one thing only: whether the
      phone is on a VPN, which is why Facebook rations the feed and which sentence the status
      banner should then add. It reveals nothing about the connection beyond that.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.CheckpointWatch"
        android:usesCleartextTraffic="false">

        <!--
          WebView phones home to Google unless told not to.

          MetricsOptOut turns off the WebView's own usage/metrics reporting. It is nominally tied
          to the user's Play-services metrics choice, which does not exist on GrapheneOS, so
          saying no explicitly costs nothing and removes the question.

          Safe Browsing is disabled because it is a lookup service: on stock Android the WebView
          would send information about the URLs it loads to Google. The one page this app ever
          loads is a fixed, known Facebook URL that the navigation guard will not let it leave, so
          the check buys nothing and the traffic is exactly what the privacy note promises does
          not happen. (On GrapheneOS, Vanadium does not do these lookups anyway; this makes the
          behaviour the same on any WebView provider.)
        -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
